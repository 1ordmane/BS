---
import '@/styles/global.css';
import '@/styles/admin.css';
import Icon from '@/components/Icon.astro';
import { countByStatus } from '@/server/inquiries';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session!;
const newRequests = countByStatus().new ?? 0;
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';

const nav = [
  { href: '/admin', label: 'Обзор', icon: 'LayoutDashboard', exact: true },
  { href: '/admin/projects', label: 'Проекты', icon: 'FolderKanban' },
  { href: '/admin/homepage', label: 'Главная страница', icon: 'House' },
  { href: '/admin/about', label: 'Подход и преимущества', icon: 'Building2' },
  { href: '/admin/services', label: 'Услуги', icon: 'Layers' },
  { href: '/admin/media', label: 'Медиатека', icon: 'Images' },
  { href: '/admin/requests', label: 'Заявки', icon: 'Inbox', count: newRequests },
  { href: '/admin/settings', label: 'Настройки', icon: 'Settings' },
];
const isCurrent = (item: (typeof nav)[number]) => (item.exact ? path === item.href : path === item.href || path.startsWith(`${item.href}/`));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content={session.csrfToken} />
    <title>{title} — админ-панель BUSINESS STAND</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="admin" data-admin>
      <button class="admin-menu-toggle" type="button" aria-expanded="false" aria-controls="admin-sidebar" data-admin-menu>
        <Icon name="Menu" size={20} /> Меню
      </button>

      <aside class="admin-sidebar" id="admin-sidebar">
        <a class="admin-brand" href="/admin">
          <img src="/logo/logo-poster.webp" alt="" width="40" height="40" />
          <span>BUSINESS STAND<small>Админ-панель</small></span>
        </a>
        <nav class="admin-nav" aria-label="Разделы админ-панели">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
                <Icon name={item.icon} size={18} />
                {item.label}
                {item.count ? <span class="count" aria-label={`новых: ${item.count}`}>{item.count}</span> : null}
              </a>
            ))
          }
        </nav>
        <div class="admin-sidebar__foot">
          <a href="/" target="_blank" rel="noopener">Открыть сайт ↗</a>
          <span>{session.user.email}</span>
          <form method="post" action="/admin/logout">
            <input type="hidden" name="_csrf" value={session.csrfToken} />
            <button class="link-button" type="submit">Выйти</button>
          </form>
        </div>
      </aside>

      <main class="admin-main" id="main">
        <slot />
      </main>
    </div>

    <script>
      const root = document.querySelector<HTMLElement>('[data-admin]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-admin-menu]');
      toggle?.addEventListener('click', () => {
        const open = !root?.classList.contains('menu-open');
        root?.classList.toggle('menu-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
