---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Icon from '@/components/Icon.astro';
import { ru } from '@/data/ru';
import { formatDate } from '@/lib/format';
import { getImageView } from '@/server/images';
import { listProjects } from '@/server/projects';
import { readFeatured } from '@/server/content';

const params = Astro.url.searchParams;
const query = {
  q: params.get('q') ?? '',
  status: params.get('status') ?? '',
  category: params.get('category') ?? '',
  sort: params.get('sort') ?? 'updated',
  dir: params.get('dir') ?? 'desc',
};
const projects = listProjects(query);
const featured = new Set(readFeatured('published'));
const categoryLabel = (id: string) => ru.projectCategories.find((c) => c.id === id)?.label ?? id;

// Column headers toggle the sort direction.
const sortLink = (key: string) => {
  const next = new URLSearchParams(params);
  next.set('sort', key);
  next.set('dir', query.sort === key && query.dir === 'desc' ? 'asc' : 'desc');
  return `?${next}`;
};
const sortMark = (key: string) => (query.sort === key ? (query.dir === 'asc' ? ' ↑' : ' ↓') : '');
---

<AdminLayout title="Проекты">
  <div class="admin-head">
    <div>
      <h1>Проекты</h1>
      <p>Все проекты каталога. На главной показываются те, что выбраны в разделе «Главная страница».</p>
    </div>
    <div class="admin-head__actions">
      <a class="button button--primary" href="/admin/projects/new"><Icon name="Plus" size={16} /> Новый проект</a>
    </div>
  </div>

  {params.has('deleted') && <p class="notice notice--info" style="margin-bottom:1rem">Проект удалён.</p>}

  <form class="filters" method="get" role="search">
    <div class="field field--grow">
      <label for="f-q">Поиск</label>
      <input id="f-q" type="search" name="q" value={query.q} placeholder="Название, клиент, выставка или адрес" />
    </div>
    <div class="field">
      <label for="f-status">Статус</label>
      <select id="f-status" name="status">
        <option value="">Все</option>
        <option value="published" selected={query.status === 'published'}>Опубликованные</option>
        <option value="draft" selected={query.status === 'draft'}>Черновики</option>
      </select>
    </div>
    <div class="field">
      <label for="f-category">Формат</label>
      <select id="f-category" name="category">
        <option value="">Все форматы</option>
        {ru.projectCategories.map((c) => <option value={c.id} selected={query.category === c.id}>{c.label}</option>)}
      </select>
    </div>
    <input type="hidden" name="sort" value={query.sort} />
    <input type="hidden" name="dir" value={query.dir} />
    <button class="button button--ghost" type="submit"><Icon name="Search" size={16} /> Найти</button>
  </form>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">Обложка</span></th>
          <th scope="col"><a href={sortLink('title')}>Название{sortMark('title')}</a></th>
          <th scope="col"><a href={sortLink('status')}>Статус{sortMark('status')}</a></th>
          <th scope="col">Формат</th>
          <th scope="col">Фото</th>
          <th scope="col"><a href={sortLink('created')}>Создан{sortMark('created')}</a></th>
          <th scope="col"><a href={sortLink('updated')}>Изменён{sortMark('updated')}</a></th>
        </tr>
      </thead>
      <tbody>
        {
          projects.map((project) => {
            const cover = getImageView(project.cover_image_id);
            return (
              <tr>
                <td>{cover ? <img class="thumb" src={cover.thumb} alt="" loading="lazy" /> : <span class="thumb" style="display:block" />}</td>
                <td class="title-cell">
                  <a href={`/admin/projects/${project.id}`}>{project.title}</a>
                  <div class="muted" style="font-size:.75rem">/projects/{project.slug}/{featured.has(project.id) ? ' · на главной' : ''}</div>
                </td>
                <td><span class={`badge badge--${project.status}`}>{project.status === 'published' ? 'Опубликован' : 'Черновик'}</span></td>
                <td>{categoryLabel(project.category)}</td>
                <td>{project.images}</td>
                <td>{formatDate(project.created_at)}</td>
                <td>{formatDate(project.updated_at)}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
    {projects.length === 0 && <p class="empty">{query.q || query.status || query.category ? 'Ничего не найдено. Измените условия поиска.' : 'Проектов пока нет.'}</p>}
  </div>
</AdminLayout>
