---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { formatDate } from '@/lib/format';
import { STATUSES, STATUS_LABELS, countByStatus, listInquiries } from '@/server/inquiries';

const status = Astro.url.searchParams.get('status') ?? '';
const q = Astro.url.searchParams.get('q') ?? '';
const inquiries = listInquiries({ status, q });
const counts = countByStatus();
---

<AdminLayout title="Заявки">
  <div class="admin-head">
    <div>
      <h1>Заявки</h1>
      <p>Заявки с формы на сайте. Уведомления на почту или в Telegram не настроены — новые заявки появляются только здесь.</p>
    </div>
  </div>

  <form class="filters" method="get" role="search">
    <div class="field field--grow">
      <label for="r-q">Поиск</label>
      <input id="r-q" type="search" name="q" value={q} placeholder="Имя, компания, почта, телефон, выставка" />
    </div>
    <div class="field">
      <label for="r-status">Статус</label>
      <select id="r-status" name="status">
        <option value="">Активные</option>
        {STATUSES.map((s) => <option value={s} selected={status === s}>{STATUS_LABELS[s]} ({counts[s] ?? 0})</option>)}
        <option value="all" selected={status === 'all'}>Все</option>
      </select>
    </div>
    <button class="button button--ghost" type="submit">Показать</button>
  </form>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Дата</th>
          <th scope="col">Контакт</th>
          <th scope="col">Выставка</th>
          <th scope="col">Площадь</th>
          <th scope="col">Статус</th>
        </tr>
      </thead>
      <tbody>
        {
          inquiries.map((item) => (
            <tr>
              <td style="white-space:nowrap">{formatDate(item.created_at)}</td>
              <td class="title-cell">
                <a href={`/admin/requests/${item.id}`}>{item.name}</a>
                <div class="muted" style="font-size:.75rem">
                  {[item.company, item.email].filter(Boolean).join(' · ')}
                  {item.attachment_file && ' · 📎'}
                </div>
              </td>
              <td>{item.event || '—'}</td>
              <td>{item.area ? `${item.area} м²` : '—'}</td>
              <td><span class={`badge badge--${item.status}`}>{STATUS_LABELS[item.status]}</span></td>
            </tr>
          ))
        }
      </tbody>
    </table>
    {inquiries.length === 0 && <p class="empty">Заявок нет.</p>}
  </div>
</AdminLayout>
