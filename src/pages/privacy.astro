---
import LegalPage from '@/components/LegalPage.astro';
import { getContent } from '@/data';
import { actions, formData, operator, operatorDetails, requestChannels } from '@/data/legal';
import { INQUIRY_RECIPIENT, mailTransport } from '@/server/mail';

/**
 * Политика обработки персональных данных (ст. 18.1 152-ФЗ). Structure follows Roskomnadzor's
 * recommendations of 31.07.2017. It describes only what the site actually does (see
 * src/pages/api/inquiry.ts, src/server/mail.ts); company facts come from src/data/legal.ts
 * and the admin settings, and empty ones are left out.
 */
const { meta } = getContent(Astro.currentLocale);
const { company } = Astro.locals.site;
const details = operatorDetails();
const channels = requestChannels(company);
// Where the inquiries go (src/server/mail.ts).
const inbox = mailTransport()?.to ?? INQUIRY_RECIPIENT;
const yandexInbox = /@(yandex\.(ru|com)|ya\.ru)$/i.test(inbox);

const toc = [
  { id: 'general', title: 'Общие положения' },
  { id: 'terms', title: 'Основные понятия' },
  { id: 'data', title: 'Какие данные мы обрабатываем' },
  { id: 'purposes', title: 'Цели и правовые основания' },
  { id: 'processing', title: 'Как мы обрабатываем данные' },
  { id: 'retention', title: 'Сроки хранения и уничтожение' },
  { id: 'cookies', title: 'Cookie, аналитика и мессенджеры' },
  { id: 'protection', title: 'Защита данных' },
  { id: 'rights', title: 'Ваши права' },
  { id: 'requests', title: 'Запросы и отзыв согласия' },
  { id: 'final', title: 'Заключительные положения' },
];
---

<LegalPage
  title="Политика обработки персональных данных"
  metaTitle={meta.privacy.title}
  description={meta.privacy.description}
  lead={`Как ${operator.name} получает, использует и защищает персональные данные, которые вы оставляете на этом сайте.`}
  toc={toc}
>
  <section id="general" aria-labelledby="general-title">
    <h2 id="general-title">1. Общие положения</h2>
    <p>
      Настоящая политика определяет порядок обработки персональных данных посетителей этого сайта и меры по их
      защите. Она подготовлена в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных»
      (далее — Закон) и опубликована на сайте в свободном доступе, как требует часть 2 статьи 18.1 Закона.
    </p>
    <p>
      Оператор персональных данных — {operator.name} (далее — Оператор, мы). Персональные данные, отправленные
      через сайт, обрабатывает только {operator.name}.
    </p>
    {
      details.length > 0 && (
        <dl>
          {details.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    {operator.responsible && <p>Ответственный за организацию обработки персональных данных: {operator.responsible}.</p>}
    <p>
      Политика распространяется на персональные данные, которые Оператор получает через этот сайт: из формы заявки
      и при защите формы от автоматических отправок.
    </p>
  </section>

  <section id="terms" aria-labelledby="terms-title">
    <h2 id="terms-title">2. Основные понятия</h2>
    <p>Понятия используются в значении, которое им придаёт статья 3 Закона:</p>
    <ul>
      <li>
        <strong>персональные данные</strong> — любая информация, относящаяся прямо или косвенно к определённому или
        определяемому физическому лицу (субъекту персональных данных);
      </li>
      <li>
        <strong>обработка персональных данных</strong> — любое действие или совокупность действий с персональными
        данными, совершаемых с использованием средств автоматизации или без них;
      </li>
      <li>
        <strong>оператор</strong> — лицо, которое организует и (или) осуществляет обработку персональных данных и
        определяет её цели, состав данных и действия с ними.
      </li>
    </ul>
  </section>

  <section id="data" aria-labelledby="data-title">
    <h2 id="data-title">3. Какие данные мы обрабатываем</h2>
    <p>Мы обрабатываем данные посетителей сайта, которые отправляют заявку через форму на сайте.</p>
    <h3>Данные, которые вы указываете в форме заявки</h3>
    <ul>
      {formData.required.map((item) => <li>{item} — обязательно;</li>)}
      {formData.optional.map((item) => <li>{item} — по вашему желанию;</li>)}
    </ul>
    <h3>Данные, которые добавляются к заявке автоматически</h3>
    <ul>
      {formData.automatic.map((item) => <li>{item};</li>)}
    </ul>
    <h3>Данные для защиты формы</h3>
    <ul>
      <li>IP-адрес устройства, с которого отправляется заявка.</li>
    </ul>
    <p>
      Мы не запрашиваем специальные категории персональных данных (о здоровье, политических взглядах, религиозных
      убеждениях и т. п.) и биометрические данные. Пожалуйста, не указывайте их в описании проекта и в прикреплённых
      файлах, а также не указывайте данные других людей без их согласия.
    </p>
  </section>

  <section id="purposes" aria-labelledby="purposes-title">
    <h2 id="purposes-title">4. Цели и правовые основания обработки</h2>
    <h3>Рассмотрение заявки и связь с вами</h3>
    <p>
      Данные из формы заявки мы используем, чтобы рассмотреть заявку, связаться с вами по указанным контактам,
      подготовить предложение и обсудить проект выставочного стенда. Правовое основание — ваше согласие на обработку
      персональных данных (пункт 1 части 1 статьи 6 Закона). Согласие оформлено отдельным документом —
      <a href="/consent/">«Согласие на обработку персональных данных»</a> — и даётся отметкой в форме заявки.
      Без согласия форма не отправляется.
    </p>
    <h3>Защита формы от злоупотреблений</h3>
    <p>
      IP-адрес используется только для того, чтобы ограничить число заявок с одного адреса за короткое время и
      защитить сайт от автоматических рассылок. Правовое основание — законный интерес Оператора в защите сайта
      (пункт 7 части 1 статьи 6 Закона); IP-адрес не используется для других целей и не связывается с другими
      сведениями о вас.
    </p>
    <p>Мы не используем ваши данные для рекламных рассылок и не принимаем на их основе решений, порождающих для вас юридические последствия.</p>
  </section>

  <section id="processing" aria-labelledby="processing-title">
    <h2 id="processing-title">5. Как мы обрабатываем данные</h2>
    <p>
      Обработка ведётся с использованием средств автоматизации. С данными совершаются следующие действия: {actions}.
    </p>
    <p>
      Заявка вместе с прикреплённым файлом отправляется письмом на адрес электронной почты Оператора
      <a href={`mailto:${inbox}`}>{inbox}</a>{yandexInbox ? ' (сервис «Яндекс Почта»)' : ''}. Письмо передаётся по
      защищённому соединению. На сайте заявки и файлы не сохраняются. Сайт не передаёт заявки в другие внешние
      сервисы — CRM-системы, сервисы рассылок или аналитики.
    </p>
    {operator.dataLocation && <p>Данные хранятся {operator.dataLocation}.</p>}
    {
      operator.processors.length > 0 && (
        <>
          <p>По поручению Оператора данные обрабатывают:</p>
          <ul>
            {operator.processors.map((processor) => (
              <li>
                {processor.name}, {processor.address} — {processor.purpose};
              </li>
            ))}
          </ul>
        </>
      )
    }
    {operator.crossBorderTransfer === false && <p>Трансграничная передача персональных данных не осуществляется.</p>}
    <p>
      Мы не продаём и не распространяем персональные данные. Сведения могут быть предоставлены государственным
      органам только в случаях и в порядке, которые предусмотрены законодательством Российской Федерации. Оператор и
      лица, получившие доступ к персональным данным, не раскрывают их третьим лицам без согласия субъекта, если иное
      не предусмотрено федеральным законом (статья 7 Закона).
    </p>
  </section>

  <section id="retention" aria-labelledby="retention-title">
    <h2 id="retention-title">6. Сроки хранения и уничтожение</h2>
    <ul>
      <li>
        Письма с заявками хранятся в почтовом ящике Оператора до достижения целей обработки — рассмотрения заявки и
        обсуждения проекта — или до отзыва согласия{operator.retention ? `, но не дольше чем ${operator.retention}` : ''}.
        После этого обработка прекращается, а данные уничтожаются в срок не более 30 дней, если иное не
        предусмотрено договором или федеральным законом (части 4 и 5 статьи 21 Закона).
      </li>
      <li>Сайт не хранит заявки и прикреплённые файлы: после отправки письма они не остаются на сервере сайта.</li>
      <li>Записи с IP-адресами для защиты формы удаляются автоматически не позднее чем через сутки.</li>
    </ul>
  </section>

  <section id="cookies" aria-labelledby="cookies-title">
    <h2 id="cookies-title">7. Cookie, аналитика и мессенджеры</h2>
    <p>
      Публичные страницы сайта не устанавливают cookie, не сохраняют данные в вашем браузере и не используют
      системы веб-аналитики и рекламные счётчики. Шрифты и изображения загружаются с сервера сайта, без обращения к
      сторонним сервисам. Технический cookie используется только в разделе управления сайтом, чтобы сотрудники
      Оператора могли войти в него.
    </p>
    <p>
      На сайте есть ссылки на мессенджеры Telegram, WhatsApp и MAX. Сайт не передаёт в мессенджеры ваши персональные
      данные: в WhatsApp открывается чат с заранее подготовленным текстом обращения, который вы можете изменить, в
      Telegram и MAX — чат или профиль без текста. Переходя в мессенджер, вы пользуетесь сервисом другой компании, и
      обработка данных в нём регулируется правилами этого сервиса. Сведения, которые вы сами отправите нам в
      мессенджере, мы используем, чтобы ответить вам и обсудить проект.
    </p>
  </section>

  <section id="protection" aria-labelledby="protection-title">
    <h2 id="protection-title">8. Защита данных</h2>
    <p>
      Оператор принимает правовые, организационные и технические меры, необходимые для защиты персональных данных от
      неправомерного или случайного доступа, уничтожения, изменения, блокирования, копирования, предоставления и
      распространения (статьи 18.1 и 19 Закона). На сайте, в частности:
    </p>
    <ul>
      <li>заявки отправляются на почту Оператора по защищённому соединению и не сохраняются на сайте;</li>
      <li>число попыток входа в раздел управления ограничено, после нескольких неудачных попыток вход блокируется;</li>
      <li>cookie входа сотрудников недоступен скриптам страницы и передаётся только по защищённому соединению;</li>
      <li>форма принимает заявки только с этого сайта и ограничивает частоту отправки с одного адреса;</li>
      <li>прикреплённые файлы проверяются по формату, содержимому и размеру.</li>
    </ul>
    <p>
      Если произойдёт неправомерная передача персональных данных, Оператор уведомит Роскомнадзор в сроки,
      установленные частью 3.1 статьи 21 Закона.
    </p>
  </section>

  <section id="rights" aria-labelledby="rights-title">
    <h2 id="rights-title">9. Ваши права</h2>
    <p>В соответствии с Законом вы вправе:</p>
    <ul>
      <li>
        получить сведения об обработке ваших персональных данных: факт обработки, её правовые основания, цели и
        способы, состав данных и источник их получения, сроки обработки и хранения, сведения об Операторе и о лицах,
        которым данные могут быть раскрыты (часть 7 статьи 14 Закона);
      </li>
      <li>
        потребовать уточнить, заблокировать или уничтожить данные, если они неполные, устаревшие, неточные, незаконно
        получены или не нужны для заявленной цели;
      </li>
      <li>в любой момент отозвать согласие на обработку персональных данных;</li>
      <li>потребовать прекратить обработку персональных данных;</li>
      <li>
        обжаловать действия или бездействие Оператора в Федеральную службу по надзору в сфере связи, информационных
        технологий и массовых коммуникаций (Роскомнадзор) или в суд.
      </li>
    </ul>
  </section>

  <section id="requests" aria-labelledby="requests-title">
    <h2 id="requests-title">10. Запросы и отзыв согласия</h2>
    {
      channels.length > 0 && (
        <>
          <p>Чтобы отправить запрос, отозвать согласие или потребовать прекратить обработку, свяжитесь с нами:</p>
          <dl>
            {channels.map((channel) => (
              <div>
                <dt>{channel.label}</dt>
                <dd>{channel.href ? <a href={channel.href}>{channel.value}</a> : channel.value}</dd>
              </div>
            ))}
          </dl>
        </>
      )
    }
    <p>
      В запросе укажите, как к вам обращаться, и данные, по которым мы сможем найти вашу заявку, — например, адрес
      электронной почты, указанный в форме. Мы можем попросить подтвердить, что запрос отправили именно вы.
    </p>
    <p>Сроки, установленные Законом:</p>
    <ul>
      <li>
        ответ на запрос о предоставлении сведений — в течение 10 рабочих дней с даты получения запроса; срок может
        быть продлён не более чем на 5 рабочих дней с направлением вам мотивированного уведомления (статья 20 Закона);
      </li>
      <li>уточнение неполных или неточных данных — в течение 7 рабочих дней;</li>
      <li>
        прекращение обработки по вашему требованию — в течение 10 рабочих дней, с возможным продлением не более чем
        на 5 рабочих дней с мотивированным уведомлением;
      </li>
      <li>
        после отзыва согласия — прекращение обработки и уничтожение данных в срок не более 30 дней с даты получения
        отзыва, если иное не предусмотрено федеральным законом.
      </li>
    </ul>
  </section>

  <section id="final" aria-labelledby="final-title">
    <h2 id="final-title">11. Заключительные положения</h2>
    <p>
      Оператор может изменять политику, например при изменении законодательства или работы сайта. Новая редакция
      вступает в силу с момента её публикации на этой странице. Действующая редакция всегда доступна по адресу этой
      страницы.
    </p>
    <p>
      Текст согласия на обработку персональных данных, которое даётся при отправке заявки, опубликован на странице
      <a href="/consent/">«Согласие на обработку персональных данных»</a>.
    </p>
  </section>
</LegalPage>
