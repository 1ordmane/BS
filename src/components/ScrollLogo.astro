---
import frames from '@/data/logo-frames.json';
---

<!--
  Animated logo built from the frames of the logo video (see scripts/logo-frames.py).
  On every page load it plays through once, then holds the last frame; from then on
  the animation follows the page scroll: the first frame at the top, the last at the bottom.
  The first frame is shown until the sheet loads, and stays when the visitor
  prefers reduced motion.
-->
<span class="scroll-logo" style={`--logo-bg: ${frames.background}`} data-scroll-logo>
  <img
    class="scroll-logo__poster"
    src={frames.poster}
    alt=""
    width={frames.sheets.at(-1)!.size}
    height={frames.sheets.at(-1)!.size}
    decoding="async"
  />
  <canvas class="scroll-logo__canvas" aria-hidden="true"></canvas>
</span>

<style>
  .scroll-logo {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    background: var(--logo-bg);
  }

  .scroll-logo__poster,
  .scroll-logo__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scroll-logo__canvas {
    opacity: 0;
  }

  .scroll-logo.is-ready .scroll-logo__canvas {
    opacity: 1;
  }
</style>

<script>
  import frames from '@/data/logo-frames.json';

  type Sheet = (typeof frames.sheets)[number];

  const root = document.querySelector<HTMLElement>('[data-scroll-logo]');
  const canvas = root?.querySelector('canvas');
  const context = canvas?.getContext('2d');
  // Scratch canvas for turning the lettering ring of a frame.
  const ring = document.createElement('canvas');
  const ringContext = ring.getContext('2d');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root && canvas && context && ringContext) {
    // The sheet being loaded, and the one that is loaded and drawn from.
    let requested: Sheet | null = null;
    let active: { sheet: Sheet; image: HTMLImageElement } | null = null;
    let mask: Promise<HTMLImageElement> | null = null;
    let maskImage: HTMLImageElement | null = null;
    let shown = NaN;
    let queued = false;

    // intro: plays once on load, whatever the scroll position.
    // held: intro finished at the top of the page; the last frame stays until the first scroll.
    // scroll: the animation follows the scroll position.
    let mode: 'intro' | 'held' | 'scroll' = 'intro';
    let introStart = -1;
    const INTRO_MS = 1200;

    // Position in the animation: 0 is the first frame, 1 the last, i.e. one full turn of the ring.
    // It eases towards the scroll position so wheel steps turn the ring instead of snapping it.
    let position = 0;
    let lastTime = -1;
    const FOLLOW_MS = 90;

    const { turns } = frames;
    const easeInOut = (t: number) => (1 - Math.cos(Math.PI * t)) / 2;

    // Smallest sheet that is still sharp at the logo's rendered size, or the largest one.
    // Density is capped at 2x: sharper sheets would cost phones memory for no visible gain.
    const pickSheet = () => {
      const needed = canvas.clientWidth * Math.min(window.devicePixelRatio, 2);
      return frames.sheets.find((item) => item.size >= needed) ?? frames.sheets.at(-1)!;
    };

    const progress = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return 0;
      return Math.min(1, Math.max(0, window.scrollY / scrollable));
    };

    // The frame whose ring angle is closest to the position (turns are sorted).
    const nearest = (at: number) => {
      let low = 0;
      let high = turns.length - 1;
      while (low < high) {
        const mid = (low + high) >> 1;
        if (turns[mid]! < at) low = mid + 1;
        else high = mid;
      }
      return low > 0 && at - turns[low - 1]! < turns[low]! - at ? low - 1 : low;
    };

    // Draws the closest frame, then turns its lettering ring by the angle still missing.
    // "BS" and the outer circle stay as they are in the frame.
    const paint = (at: number) => {
      // A full turn shows the same picture, so positions outside 0…1 wrap around.
      const wrapped = at - Math.floor(at) || (at > 0 ? 1 : 0);
      if (!active || !maskImage || wrapped === shown) return;
      shown = wrapped;

      const frame = nearest(wrapped);
      const { size } = active.sheet;
      const x = (frame % frames.columns) * size;
      const y = Math.floor(frame / frames.columns) * size;
      context.drawImage(active.image, x, y, size, size, 0, 0, size, size);

      const angle = (wrapped - turns[frame]!) * 2 * Math.PI;
      if (Math.abs(angle) < 0.0002) return;
      const centre = frames.ring.centre * size;
      ringContext.clearRect(0, 0, size, size);
      ringContext.translate(centre, centre);
      // The ring turns counter-clockwise.
      ringContext.rotate(-angle);
      ringContext.translate(-centre, -centre);
      // Copy the frame just drawn rather than the whole sheet: the sheet stays in one canvas only.
      ringContext.drawImage(canvas, 0, 0);
      ringContext.setTransform(1, 0, 0, 1, 0, 0);
      ringContext.globalCompositeOperation = 'destination-in';
      ringContext.drawImage(maskImage, 0, 0, size, size);
      ringContext.globalCompositeOperation = 'source-over';
      context.drawImage(ring, 0, 0);
    };

    const loop = () => {
      queued = true;
      requestAnimationFrame(draw);
    };

    // The intro ends a full turn on; follow the scroll from the equivalent position nearest to it.
    const followScroll = () => {
      mode = 'scroll';
      position -= Math.round(position - progress());
    };

    const draw = (now: number) => {
      queued = false;
      if (!active) return;
      const elapsed = lastTime < 0 ? 16 : Math.min(100, now - lastTime);
      lastTime = now;

      if (mode === 'intro') {
        if (introStart < 0) introStart = now;
        const t = Math.min(1, (now - introStart) / INTRO_MS);
        position = easeInOut(t);
        paint(position);
        // Scroll events during the intro do not restart or disturb it.
        if (t < 1) return loop();
        // Done: hold the last frame at the top, otherwise pick up where the visitor scrolled to.
        if (window.scrollY > 0) followScroll();
        else mode = 'held';
      }

      if (mode === 'scroll') {
        const target = progress();
        position += (target - position) * (1 - Math.exp(-elapsed / FOLLOW_MS));
        if (Math.abs(target - position) < 0.0004) position = target;
        paint(position);
        if (position !== target) return loop();
      } else {
        paint(position);
      }
      lastTime = -1;
    };

    const schedule = () => {
      if (!queued) loop();
    };

    const onScroll = () => {
      if (mode === 'held') followScroll();
      schedule();
    };

    const load = (next: Sheet) => {
      if (requested?.src === next.src) return;
      requested = next;
      if (!mask) {
        const image = new Image();
        image.src = frames.ring.mask;
        mask = image.decode().then(() => image);
      }
      const pending = new Image();
      pending.src = next.src;
      // Both images are decoded before the first frame is drawn, never during scrolling.
      Promise.all([pending.decode(), mask])
        .then(([, loadedMask]) => {
          // A newer sheet may have been requested while this one loaded.
          if (requested !== next) return;
          active = { sheet: next, image: pending };
          maskImage = loadedMask;
          canvas.width = canvas.height = ring.width = ring.height = next.size;
          shown = NaN;
          schedule();
          root.classList.add('is-ready');
        })
        .catch(() => {
          // Keep the first frame if the images cannot be loaded.
        });
    };

    const start = () => {
      load(pickSheet());
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize);
      pageSize.observe(document.body);
    };

    const stop = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      pageSize.disconnect();
      root.classList.remove('is-ready');
      requested = active = null;
      // The intro belongs to the page load; it does not replay if motion is allowed again later.
      mode = 'scroll';
    };

    const onResize = () => {
      load(pickSheet());
      schedule();
    };

    // The page grows as images load, which changes the scroll range.
    const pageSize = new ResizeObserver(schedule);

    if (!reducedMotion.matches) start();
    reducedMotion.addEventListener('change', () => (reducedMotion.matches ? stop() : start()));
  }
</script>
