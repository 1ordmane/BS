---
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import type { ProjectCardView } from '@/server/site';

interface Props {
  project: ProjectCardView;
  variant: string;
  sizes: string;
}

const { project, variant, sizes } = Astro.props;
---

<article class:list={['project-card', `project-card--${variant}`]}>
  <a class="project-card__link" href={`/projects/${project.slug}/`}>
    <div class="project-card__media">
      <ResponsiveImage image={project.cover} sizes={sizes} />
      <span class="project-card__open" aria-hidden="true">
        <Icon name="ArrowUpRight" size={20} />
      </span>
    </div>
    <div class="project-card__info">
      <h3 class="title project-card__title">{project.title}</h3>
      <p class="label project-card__meta">{project.categoryLabel}</p>
    </div>
  </a>
</article>

<style>
  .project-card {
    height: 100%;
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    text-decoration: none;
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--grey);
    aspect-ratio: 4 / 3;
  }

  .project-card--tall .project-card__media {
    aspect-ratio: 4 / 4.4;
  }

  .project-card--wide .project-card__media {
    aspect-ratio: 16 / 10;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .project-card__link:hover .project-card__media img {
    transform: scale(1.06);
  }

  .project-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--forest);
    font-size: var(--text-xs);
    font-weight: var(--weight-ui);
  }

  .project-card__open {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--emerald);
    color: var(--ivory);
    opacity: 0;
    transform: translateY(8px) scale(0.92);
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .project-card__link:hover .project-card__open,
  .project-card__link:focus-visible .project-card__open {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .project-card__open {
      opacity: 1;
      transform: none;
    }
  }

  /* Title first, format as a quiet caption: the photograph carries the card */
  .project-card__info {
    display: grid;
    gap: 0.6rem;
  }

  .project-card__title {
    color: var(--forest);
    transition: color 0.3s var(--ease);
  }

  .project-card__link:hover .project-card__title {
    color: var(--emerald);
  }

  .project-card__meta {
    color: var(--muted);
  }
</style>
