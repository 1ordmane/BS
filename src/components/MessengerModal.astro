---
import Icon from './Icon.astro';
import MessengerIcon from './MessengerIcon.astro';
import { messengerLinks } from '@/data/messengers';

/**
 * «Обсудить проект» window. Any link or button with data-messenger opens it; without
 * JavaScript those links simply lead to the contact form (/#contact).
 * Contact details come from the admin settings (Настройки → Мессенджеры).
 */
const links = messengerLinks(Astro.locals.site.company);
// Without a profile link, MAX is offered through the number, which must then be valid.
const offersMaxNumber = links.phoneDigits.length >= 10 && links.phoneDigits.length <= 15;
---

<dialog class="messenger" aria-labelledby="messenger-title" aria-describedby="messenger-text" data-messenger-dialog>
  <div class="messenger__panel">
    <button class="messenger__close" type="button" aria-label="Закрыть" data-messenger-close>
      <Icon name="X" size={20} />
    </button>

    <h2 class="messenger__title" id="messenger-title">Обсудим ваш проект?</h2>
    <p class="messenger__text" id="messenger-text">Выберите удобный мессенджер, чтобы обсудить ваш будущий выставочный стенд.</p>

    <ul class="messenger__options" role="list">
      {
        links.telegram && (
          <li>
            <a class="messenger__option" href={links.telegram} target="_blank" rel="noopener noreferrer" autofocus>
              <span class="messenger__icon"><MessengerIcon name="telegram" /></span>
              <span class="messenger__name">Telegram<small>Откроется чат с нами</small></span>
              <Icon name="ArrowUpRight" size={18} />
            </a>
          </li>
        )
      }
      {
        links.whatsapp && (
          <li>
            <a class="messenger__option" href={links.whatsapp} target="_blank" rel="noopener noreferrer">
              <span class="messenger__icon"><MessengerIcon name="whatsapp" /></span>
              <span class="messenger__name">WhatsApp<small>Откроется чат с готовым сообщением</small></span>
              <Icon name="ArrowUpRight" size={18} />
            </a>
          </li>
        )
      }
      {
        links.max ? (
          <li>
            <a class="messenger__option" href={links.max} target="_blank" rel="noopener noreferrer">
              <span class="messenger__icon"><MessengerIcon name="max" /></span>
              <span class="messenger__name">MAX<small>Откроется наш профиль в MAX</small></span>
              <Icon name="ArrowUpRight" size={18} />
            </a>
          </li>
        ) : (
          offersMaxNumber && (
            <li>
              <button class="messenger__option" type="button" aria-expanded="false" aria-controls="messenger-max" data-max-toggle>
                <span class="messenger__icon"><MessengerIcon name="max" /></span>
                <span class="messenger__name">MAX<small>Номер для поиска в MAX</small></span>
                <Icon name="ChevronDown" size={18} />
              </button>
            </li>
          )
        )
      }
    </ul>

    {
      !links.max && offersMaxNumber && (
        <div class="messenger__max" id="messenger-max" hidden data-max-panel>
          <p>MAX не открывает чат по ссылке с номером. Найдите нас в MAX по этому номеру:</p>
          <div class="messenger__copy">
            <span class="messenger__phone">{links.phone}</span>
            <button class="button button--ghost messenger__copy-button" type="button" data-copy={links.phone}>Скопировать номер</button>
          </div>
        </div>
      )
    }

    <p class="messenger__note">
      {links.whatsapp && <>В WhatsApp откроется готовое сообщение — его можно изменить перед отправкой. </>}
      <a href="/#contact" data-messenger-form>Или оставьте заявку через форму</a>
    </p>
    <p class="visually-hidden" role="status" aria-live="polite" data-messenger-status></p>
  </div>
</dialog>

<style>
  .messenger {
    width: min(480px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    color: var(--charcoal);
    box-shadow: 0 40px 100px -30px rgb(13 48 40 / 0.55);
    overflow: auto;
  }

  .messenger::backdrop {
    background: rgb(13 48 40 / 0.55);
    backdrop-filter: blur(3px);
  }

  .messenger[open] {
    animation: messenger-in 0.35s var(--ease-out);
  }

  .messenger[open]::backdrop {
    animation: messenger-fade 0.35s var(--ease-out);
  }

  @keyframes messenger-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  @keyframes messenger-fade {
    from {
      opacity: 0;
    }
  }

  .messenger__panel {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
  }

  .messenger__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--charcoal);
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .messenger__close:hover {
    border-color: var(--emerald);
    color: var(--emerald);
  }

  .messenger__title {
    padding-right: 3rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    color: var(--forest);
  }

  .messenger__text {
    max-width: 26rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .messenger__options {
    display: grid;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .messenger__option {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--forest);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .messenger__option:hover,
  .messenger__option:focus-visible {
    border-color: var(--emerald);
    box-shadow: var(--shadow-soft);
    transform: translateY(-1px);
  }

  .messenger__option :global(.icon) {
    color: var(--muted);
    transition: color 0.25s var(--ease);
  }

  .messenger__option:hover :global(.icon) {
    color: var(--emerald);
  }

  .messenger__option[aria-expanded='true'] :global(.icon) {
    transform: rotate(180deg);
  }

  .messenger__option.is-unavailable {
    cursor: default;
    opacity: 0.55;
    transform: none;
    box-shadow: none;
  }

  .messenger__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--warm-white);
  }

  .messenger__name {
    display: grid;
    gap: 0.1rem;
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .messenger__name small {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--muted);
  }

  .messenger__max {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--emerald-soft);
    color: var(--forest);
    font-size: var(--text-sm);
  }

  .messenger__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .messenger__phone {
    margin-right: auto;
    font-weight: 600;
    font-size: 1rem;
  }

  .messenger__copy-button {
    min-height: 36px;
    padding: 0.35rem 0.9rem;
    font-size: var(--text-xs);
    background: #fff;
  }

  .messenger__note {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .messenger__note a {
    display: block;
    width: fit-content;
    margin-top: 0.35rem;
    color: var(--forest);
  }

  /* Phones: the window rises from the bottom edge */
  @media (max-width: 560px) {
    .messenger {
      width: 100vw;
      max-width: 100vw;
      margin: auto 0 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    @keyframes messenger-in {
      from {
        transform: translateY(40px);
      }
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-messenger-dialog]');

  if (dialog) {
    const status = dialog.querySelector<HTMLElement>('[data-messenger-status]')!;
    let opener: HTMLElement | null = null;

    const open = (trigger: HTMLElement) => {
      opener = trigger;
      // The page behind stays put; the dialog itself makes it inert for clicks and focus.
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
    };

    dialog.addEventListener('close', () => {
      // The portfolio menu or another window may still need the page held still.
      if (!document.querySelector('dialog[open], [data-scroll-lock].is-open')) document.documentElement.style.overflow = '';
      opener?.focus({ preventScroll: true });
      opener = null;
    });

    // Every «Обсудить проект» link opens the window instead of jumping to the form.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-messenger]');
      if (!trigger || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      open(trigger);
    });

    dialog.querySelector('[data-messenger-close]')!.addEventListener('click', () => dialog.close());

    // A click on the dimmed area (the dialog box itself, outside the panel) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // The form link closes the window and lets the page scroll to the form.
    dialog.querySelector('[data-messenger-form]')!.addEventListener('click', () => dialog.close());

    const copy = async (text: string, done: string) => {
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = done;
        return true;
      } catch {
        status.textContent = 'Не удалось скопировать автоматически — выделите текст вручную.';
        return false;
      }
    };

    dialog.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      const label = button.textContent ?? '';
      button.addEventListener('click', async () => {
        if (await copy(button.dataset.copy ?? '', `${label}: готово`)) {
          button.textContent = 'Скопировано';
          setTimeout(() => (button.textContent = label), 2000);
        }
      });
    });

    const toggle = dialog.querySelector<HTMLButtonElement>('[data-max-toggle]');
    const panel = dialog.querySelector<HTMLElement>('[data-max-panel]');
    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(expanded));
      if (panel) panel.hidden = !expanded;
    });

  }
</script>
