---
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';
import MessengerIcon from './MessengerIcon.astro';
import { getContent } from '@/data';
import { contactChannels } from '@/data/contacts';
import { messengerLinks } from '@/data/messengers';

/**
 * The end of the page: an invitation to talk, the quickest ways to do it (messengers, set in
 * Настройки → Мессенджеры), the company's contact details and the inquiry form.
 */
const { homepage, company } = Astro.locals.site;
const contact = homepage.contact;
const labels = getContent(Astro.currentLocale).contact;
const copy = labels.copy;
// Only the contact details filled in under Настройки; empty ones are left out.
const channels = contactChannels(company).filter((channel) => channel.value);
const links = messengerLinks(company);
// MAX has no chat link by number: its button opens the messenger window with the number to copy.
const offersMax = Boolean(links.max) || links.phoneDigits.length >= 10;
const hasMessengers = Boolean(links.telegram || links.whatsapp || offersMax);
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro">
      <h2 class="contact__title" id="contact-title">{contact.title}</h2>
      {contact.text && <p class="contact__lead">{contact.text}</p>}

      {
        hasMessengers && (
          <div class="contact__quick">
            <p class="contact__label">{labels.messengersTitle}</p>
            <ul class="contact__messengers" role="list">
              {links.telegram && (
                <li>
                  <a class="messenger-link" href={links.telegram} target="_blank" rel="noopener noreferrer">
                    <MessengerIcon name="telegram" size={22} />
                    Telegram
                  </a>
                </li>
              )}
              {links.whatsapp && (
                <li>
                  <a class="messenger-link" href={links.whatsapp} target="_blank" rel="noopener noreferrer">
                    <MessengerIcon name="whatsapp" size={22} />
                    WhatsApp
                  </a>
                </li>
              )}
              {offersMax && (
                <li>
                  <button class="messenger-link" type="button" data-messenger aria-haspopup="dialog">
                    <MessengerIcon name="max" size={22} />
                    MAX
                  </button>
                </li>
              )}
            </ul>
          </div>
        )
      }

      {
        channels.length > 0 && (
          <dl class="contact__channels">
            {channels.map((channel) => (
              <div class="contact__channel">
                <dt>{channel.label}</dt>
                <dd>
                  {channel.href ? <a class="contact__value" href={channel.href}>{channel.value}</a> : <span class="contact__value">{channel.value}</span>}
                  {channel.copy && (
                    <button
                      class="contact__copy"
                      type="button"
                      data-copy-text={channel.copy.text}
                      aria-label={copy[channel.copy.label]}
                      data-done={copy.done}
                      data-failed={copy.failed}
                      hidden
                    >
                      <Icon name="Copy" size={16} class="contact__copy-icon" />
                      <Icon name="Check" size={16} class="contact__copy-done" />
                      <span data-copy-label>{copy.button}</span>
                    </button>
                  )}
                </dd>
              </div>
            ))}
          </dl>
          <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
        )
      }
    </div>

    <div class="contact__form">
      <h3 class="contact__form-title">{labels.formTitle}</h3>
      <InquiryForm />
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--hall);
    color: var(--on-dark);
    padding-block: clamp(4.5rem, 3rem + 5vw, 8rem);
  }

  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  @media (min-width: 1100px) {
    .contact__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .contact__title {
    max-width: 10em;
    font-family: var(--font-display);
    font-size: var(--display-md);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    color: #fff;
    text-wrap: balance;
  }

  .contact__lead {
    max-width: 26rem;
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--on-dark-muted);
  }

  .contact__quick {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .contact__label {
    margin-bottom: 0.85rem;
    font-size: var(--text-sm);
    color: var(--on-dark-muted);
  }

  .contact__messengers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
  }

  .messenger-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 52px;
    padding: 0 1.25rem 0 0.9rem;
    border: 1px solid rgb(243 241 234 / 0.3);
    border-radius: 999px;
    background: none;
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .messenger-link:hover {
    border-color: rgb(243 241 234 / 0.7);
    background: rgb(255 255 255 / 0.06);
  }

  .messenger-link:focus-visible {
    outline-color: var(--mint);
  }

  .contact__channels {
    display: grid;
    max-width: 28rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .contact__channel {
    display: grid;
    gap: 0.35rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line-on-dark);
    font-size: var(--text-sm);
  }

  .contact__channel:last-child {
    border-bottom: 1px solid var(--line-on-dark);
  }

  .contact__channel dt {
    color: var(--on-dark-muted);
  }

  /* The value on the left (a tel:/mailto: link), its copy button on the right. */
  .contact__channel dd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .contact__value {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--text-lg);
    font-weight: var(--weight-ui);
    color: #fff;
  }

  a.contact__value {
    text-decoration: underline;
    text-decoration-color: rgb(243 241 234 / 0.35);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.25s var(--ease);
  }

  a.contact__value:hover {
    text-decoration-color: #fff;
  }

  a.contact__value:focus-visible {
    outline-color: var(--mint);
    outline-offset: 3px;
  }

  .contact__copy {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.95rem;
    border: 1px solid rgb(243 241 234 / 0.35);
    border-radius: 999px;
    background: none;
    color: #fff;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .contact__copy[hidden] {
    display: none;
  }

  /* Phones: the button moves up beside the label, so the number and the address keep a full line. */
  @media (max-width: 560px) {
    .contact__channel {
      position: relative;
    }

    .contact__channel:has(.contact__copy:not([hidden])) dt {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .contact__copy {
      position: absolute;
      top: 0.9rem;
      right: 0;
    }
  }

  .contact__copy:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.08);
  }

  .contact__copy:focus-visible {
    outline-color: var(--mint);
  }

  .contact__copy :global(.contact__copy-done),
  .contact__copy.is-done :global(.contact__copy-icon) {
    display: none;
  }

  .contact__copy.is-done :global(.contact__copy-done) {
    display: inline;
  }

  .contact__copy.is-done {
    border-color: var(--mint);
    background: var(--mint);
    color: var(--forest-deep);
  }

  .contact__form {
    padding: clamp(1.5rem, 0.8rem + 2.6vw, 3rem);
    border-radius: 10px;
    background: var(--paper-raised);
    color: var(--charcoal);
  }

  .contact__form-title {
    margin-bottom: 1.75rem;
    font-family: var(--font-display);
    font-size: var(--title-lg);
    font-weight: var(--weight-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
    color: var(--forest);
  }
</style>

<script>
  // Copy buttons beside the phone and the e-mail. They appear only when JavaScript runs.
  import { copyText } from '@/scripts/copy';

  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-copy-label]')!;
    const idle = label.textContent ?? '';
    let timer = 0;
    button.hidden = false;
    button.addEventListener('click', async () => {
      const copied = await copyText(button.dataset.copyText ?? '');
      window.clearTimeout(timer);
      button.classList.toggle('is-done', copied);
      label.textContent = copied ? (button.dataset.done ?? '') : idle;
      if (status) status.textContent = copied ? `${button.dataset.done}: ${button.dataset.copyText}` : (button.dataset.failed ?? '');
      timer = window.setTimeout(() => {
        button.classList.remove('is-done');
        label.textContent = idle;
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
