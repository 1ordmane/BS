---
/**
 * What the company does and how a project runs, in one short section: the statement from
 * «Подход и преимущества», the services (admin: Услуги) and the stages of work.
 * Each service keeps its anchor (#service-…) for links from elsewhere.
 */
const { services, homepage, about } = Astro.locals.site;
const section = homepage.services;
const { approach } = about;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="capab" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="capab__head">
      <div class="capab__intro">
        <h2 class="capab__title" id="services-title">{section.title}</h2>
        {section.text && <p class="capab__lead">{section.text}</p>}
      </div>
      {about.about.lead && <p class="capab__statement">{about.about.lead}</p>}
    </div>

    {
      services.length > 0 && (
        <ul class="capab__services" role="list">
          {services.map((service) => (
            <li class="service" id={service.anchor}>
              <h3 class="service__title">{service.title}</h3>
              {service.summary && <p class="service__text">{service.summary}</p>}
            </li>
          ))}
        </ul>
      )
    }

    {
      approach.stages.length > 0 && (
        <div class="process" id="approach" aria-labelledby="approach-title">
          <div class="process__head">
            <h3 class="process__title" id="approach-title">{approach.title}</h3>
            {approach.text && <p class="process__text">{approach.text}</p>}
          </div>
          <ol class="process__stages" role="list">
            {approach.stages.map((stage, index) => (
              <li class="stage">
                <span class="stage__number" aria-hidden="true">{pad(index + 1)}</span>
                <h4 class="stage__title">{stage.title}</h4>
                <p class="stage__text">{stage.text}</p>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<style>
  .capab {
    padding-block: clamp(4.5rem, 3rem + 5vw, 8rem);
  }

  .capab__head {
    display: grid;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
  }

  .capab__intro {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .capab__title {
    font-family: var(--font-display);
    font-size: var(--display-md);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    color: var(--forest);
  }

  .capab__lead {
    max-width: 22rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* The company's own description, set large: the one claim the section makes. */
  .capab__statement {
    max-width: 30em;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.05rem + 1.2vw, 2.125rem);
    font-weight: 450;
    line-height: 1.25;
    letter-spacing: -0.012em;
    color: var(--charcoal);
    text-wrap: pretty;
  }

  @media (min-width: 1000px) {
    .capab__head {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(2rem, 1rem + 3vw, 4.5rem);
    }

    .capab__statement {
      padding-top: 0.5rem;
    }
  }

  /* ---------- Services ---------- */

  .capab__services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1rem, 0.5rem + 2vw, 3rem);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 1000px) {
    .capab__services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .service {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding-block: 1.25rem 1.75rem;
    border-top: 1px solid var(--line-strong);
  }

  .service__title {
    font-family: var(--font-display);
    font-size: var(--title-md);
    font-weight: var(--weight-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
    color: var(--forest);
  }

  .service__text {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--muted);
  }

  /* ---------- Stages ---------- */

  .process {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    border-radius: 8px;
    background: var(--paper-raised);
  }

  .process__head {
    display: grid;
    gap: 0.5rem 2rem;
  }

  @media (min-width: 1000px) {
    .process__head {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .process__title {
    font-family: var(--font-display);
    font-size: var(--title-lg);
    font-weight: var(--weight-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
    color: var(--forest);
  }

  .process__text {
    color: var(--muted);
    text-wrap: pretty;
  }

  .process__stages {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .stage {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: baseline;
  }

  .stage__number {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: var(--weight-light);
    line-height: 1;
    color: var(--emerald);
    font-variant-numeric: tabular-nums;
  }

  .stage__title {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-ui);
    color: var(--forest);
  }

  .stage__text {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--muted);
  }

  /* Wide screens: the stages read left to right along one line, like a schedule. */
  @media (min-width: 1000px) {
    .process__stages {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
      gap: 1.5rem;
    }

    .stage {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.35rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line-strong);
      position: relative;
    }

    .stage::before {
      content: '';
      position: absolute;
      top: -4px;
      left: 0;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--emerald);
    }

    .stage__number {
      grid-row: auto;
      font-size: 2.25rem;
      margin-bottom: 0.5rem;
    }
  }
</style>
