# Production domain, used for canonical URLs and Open Graph tags.
SITE_URL=https://business-stand.example

# Where the database, uploaded images, inquiry attachments and backups are stored.
# Defaults to ./data. Must be persistent storage that survives redeploys.
DATA_DIR=./data

# Server address for `npm start` (the built Node server).
HOST=0.0.0.0
PORT=4321

# Session cookies are sent only over HTTPS. Set to false only for a local network
# setup without HTTPS (on localhost they already work over HTTP).
# COOKIE_SECURE=false

# Extra host names the site answers to besides the SITE_URL domain, comma-separated
# (e.g. www.example.ru). Needed for the login form's cross-site protection.
# ALLOWED_HOSTS=www.business-stand.example

# Set to true when running behind a reverse proxy (nginx, Caddy) that sets X-Forwarded-For,
# so rate limits apply per visitor instead of to the proxy's address.
# TRUST_PROXY=true

# ---------- Inquiries by e-mail (src/server/mail.ts) ----------
# Every inquiry from the site's form is e-mailed to businesstend@yandex.ru; nothing is stored on the site.
# Without SMTP_USER and SMTP_PASS the form shows "not sent" and nothing is lost silently.
# Mailbox the site sends from, and its password. For Yandex Mail: create an app password
# (Яндекс ID → Безопасность → Пароли приложений → Почта) and allow mail clients in the mailbox
# settings (Почта → Все настройки → Почтовые программы → «С сервера imap.yandex.ru по протоколу IMAP»).
# SMTP_USER=businesstend@yandex.ru
# SMTP_PASS=app-password
# Defaults: smtp.yandex.ru, port 465 (SSL). For port 587 the connection is upgraded to TLS.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# Sender address; Yandex accepts only the mailbox itself. Defaults to SMTP_USER.
# MAIL_FROM=businesstend@yandex.ru
# Recipient; defaults to businesstend@yandex.ru.
# INQUIRY_TO=businesstend@yandex.ru
# Development and tests only: write the messages as .eml files to this folder instead of sending.
# MAIL_OUTBOX_DIR=./data/outbox
